{
  "name": "@tederash/core",
  "version": "0.1.0",
  "description": "Framework-independent adaptive accessibility runtime and profile engine",
  "license": "MIT",
  "author": "Tsegaye Shewamare <shewamaretsegaye@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/tse-coder/tederash.git",
    "directory": "packages/core"
  },
  "keywords": [
    "accessibility",
    "a11y",
    "adaptive-ui",
    "runtime",
    "profiles",
    "wcag"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build && pnpm run test"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
