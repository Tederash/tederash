{
  "name": "@tederash/assistance",
  "version": "0.1.0",
  "description": "Contextual form assistance engine with deterministic offline heuristics and pluggable AI providers",
  "license": "MIT",
  "author": "Tsegaye Shewamare <shewamaretsegaye@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/Tederash/tederash.git",
    "directory": "packages/assistance"
  },
  "keywords": [
    "accessibility",
    "a11y",
    "forms",
    "assistance",
    "cognitive",
    "wcag"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build && pnpm run test"
  },
  "dependencies": {
    "@tederash/core": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
