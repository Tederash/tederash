{
  "name": "tederash",
  "version": "0.1.0",
  "description": "Tederash — Personalized web accessibility assistant Chrome extension",
  "private": true,
  "main": "index.js",
  "scripts": {
    "dev": "next dev",
    "build": "pnpm run build:next && pnpm run build:ext && pnpm run build:manifest",
    "build:next": "next build && node scripts/postbuild-next.mjs",
    "build:ext": "node scripts/build-extension.mjs",
    "build:ext:watch": "node scripts/build-extension.mjs --watch",
    "build:manifest": "node scripts/build-manifest.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint pages src tests",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@ai-sdk/openai": "^4.0.117",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "ai": "^7.0.172",
    "aria-query": "^5.3.2",
    "dom-accessibility-api": "^0.7.1",
    "fuse.js": "^7.5.0",
    "glob": "^10.2.3",
    "next": "^13.4.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitest/coverage-v8": "^2.1.8",
    "autoprefixer": "^10.6.2",
    "esbuild": "^0.28.2",
    "eslint": "^8.57.1",
    "eslint-config-next": "^13.5.11",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jsdom": "^31.0.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vitest": "^2.1.8"
  }
}
