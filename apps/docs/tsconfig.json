{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@tederash/core": ["../../packages/core/src/index.ts"],
      "@tederash/react": ["../../packages/react/src/index.ts"],
      "@tederash/components": ["../../packages/components/src/index.ts"],
      "@tederash/assistance": ["../../packages/assistance/src/index.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "../.next/types/**/*.ts"
  ],
  "exclude": ["node_modules", "content"]
}
