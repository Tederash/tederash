{
  "name": "docs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "prebuild": "pnpm --filter \"@tederash/*\" run build",
    "build": "next build",
    "postbuild": "pagefind --site .next/server/app --output-path public/_pagefind",
    "build:search": "pagefind --site .next/server/app --output-path public/_pagefind",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tederash/assistance": "workspace:*",
    "@tederash/components": "workspace:*",
    "@tederash/core": "workspace:*",
    "@tederash/react": "workspace:*",
    "axe-core": "^4.10.2",
    "clsx": "^2.1.1",
    "lucide-react": "^0.511.0",
    "next": "^15.5.29",
    "nextra": "^4.6.1",
    "nextra-theme-docs": "^4.6.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "shiki": "^3.23.0",
    "tailwind-merge": "^3.3.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.187.0",
    "pagefind": "^1.6.0",
    "tailwindcss": "^4",
    "typescript": "^5.7.2"
  }
}
